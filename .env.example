# Copy to .env and fill in real values. Never commit .env.
# Slack values come from https://api.slack.com/apps -> your app -> Basic Information.

SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_SIGNING_SECRET=your-signing-secret

# Random string (32+ chars) used to sign the OAuth state parameter.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLACK_STATE_SECRET=your-state-secret

# 32-byte key for AES-256-GCM token encryption, as 64 hex chars or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means stored installations can no longer be decrypted.
TOKEN_ENCRYPTION_KEY=your-32-byte-key-base64

# Comma-separated bot scopes requested at install time.
SLACK_SCOPES=commands,team:read

PORT=3000
DATABASE_PATH=./data/tackle.db
LOG_LEVEL=info
